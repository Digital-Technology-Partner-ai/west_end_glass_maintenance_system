# Backend API environment template
# Copy this file to backend_api/.env and replace placeholder values.
# Do not commit real credentials.

# MongoDB
MONGODB_URL=mongodb://weg-mongo:27017
MONGODB_DB_NAME=maintenance_system

# Meta Cloud API / WhatsApp
META_APP_ID=your_meta_app_id
META_WHATSAPP_TOKEN=your_meta_whatsapp_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_VERIFY_TOKEN=your_meta_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
META_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_BUSINESS_NUMBER=your_whatsapp_business_number
WEST_END_CALL_BACK_URL=https://example.com/webhook
WEST_END_CALL_BACK_TOKEN=your_callback_token

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Admin JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_secure_password

# File storage
PHOTO_STORAGE_PATH=/data/photos
MANUAL_STORAGE_PATH=/data/manuals

# CORS
CORS_ORIGINS=http://localhost:3030,http://localhost:5173
